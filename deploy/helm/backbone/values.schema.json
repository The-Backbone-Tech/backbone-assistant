{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s@]+$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "repository",
        "digest"
      ]
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "className": {
          "type": "string",
          "minLength": 1
        },
        "size": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"
        },
        "encryptionConfirmed": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "className",
        "size",
        "encryptionConfirmed"
      ]
    },
    "rollout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 1800
        }
      },
      "required": [
        "timeoutSeconds"
      ]
    },
    "homes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 20,
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
          },
          "modelRoute": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "endpoint": {
                "type": "string",
                "pattern": "^(https?://([A-Za-z0-9.-]+|\\[[0-9a-fA-F:]+\\])(:[0-9]+)?(/[^\\s?#]*)?)?$"
              },
              "model": {
                "type": "string"
              }
            },
            "required": [
              "endpoint",
              "model"
            ]
          },
          "policy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "managed-policy.json": {
                "type": "string"
              },
              "managed-policy.json.sig": {
                "type": "string",
                "pattern": "^$|^[A-Za-z0-9+/]{86}==$"
              },
              "policy-trust.json": {
                "type": "string"
              }
            },
            "required": [
              "managed-policy.json",
              "managed-policy.json.sig",
              "policy-trust.json"
            ],
            "oneOf": [
              {
                "properties": {
                  "managed-policy.json": {
                    "const": ""
                  },
                  "managed-policy.json.sig": {
                    "const": ""
                  },
                  "policy-trust.json": {
                    "const": ""
                  }
                }
              },
              {
                "properties": {
                  "managed-policy.json": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "managed-policy.json.sig": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "policy-trust.json": {
                    "minLength": 1,
                    "type": "string"
                  }
                }
              }
            ]
          }
        },
        "required": [
          "name",
          "modelRoute",
          "policy"
        ]
      }
    },
    "trial": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plaintextKeysAcknowledged": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "plaintextKeysAcknowledged"
      ]
    },
    "namespace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$",
          "not": {
            "anyOf": [
              {
                "const": "default"
              },
              {
                "pattern": "^kube-"
              }
            ]
          }
        },
        "dedicated": {
          "type": "boolean",
          "const": true
        },
        "podSecurity": {
          "type": "string",
          "const": "baseline"
        }
      },
      "required": [
        "name",
        "dedicated",
        "podSecurity"
      ]
    },
    "backups": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "className": {
          "type": "string",
          "minLength": 1
        },
        "size": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"
        },
        "encryptionConfirmed": {
          "type": "boolean",
          "const": true
        },
        "retention": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxArchives": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "required": [
            "maxArchives"
          ]
        }
      },
      "required": [
        "className",
        "size",
        "encryptionConfirmed",
        "retention"
      ]
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "apiServerCidrs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$"
          }
        },
        "modelEgress": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "cidr": {
                "type": "string",
                "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$"
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            },
            "required": [
              "cidr",
              "port"
            ]
          }
        }
      },
      "required": [
        "apiServerCidrs",
        "modelEgress"
      ]
    }
  },
  "required": [
    "image",
    "storage",
    "rollout",
    "homes",
    "trial",
    "namespace",
    "backups",
    "network"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#"
}
