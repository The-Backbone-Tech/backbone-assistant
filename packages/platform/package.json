{
  "name": "@backbone-next/platform",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Platform ports and their composition: the api port backed by the core, with the harness configuration names (harness-pi, or the stub for tests) as the agent.",
  "backbone": {
    "layer": "platform"
  },
  "exports": {
    ".": "./src/api.ts",
    "./composition": "./src/composition/host.ts",
    "./machine-client": "./src/machine-client.ts",
    "./executable-identity": "./src/executable-identity.ts",
    "./ports": "./src/ports/harness.ts",
    "./ports/mail": "./src/ports/mail.ts",
    "./testing": "./src/testing/scripted-model.ts",
    "./gateway": "./src/gateway.ts",
    "./composition/gateway": "./src/composition/gateway.ts",
    "./composition/pieces": "./src/composition/pieces.ts",
    "./testing/time": "./src/testing/time.ts",
    "./testing/data-home": "./src/testing/data-home.ts",
    "./testing/acp": "./src/testing/acp.ts",
    "./keys": "./src/keys/vault.ts",
    "./doors": "./src/doors/client.ts",
    "./doors/api-line": "./src/doors/api-line.ts",
    "./composition/api-line": "./src/composition/api-line.ts",
    "./composition/doors": "./src/composition/doors.ts",
    "./testing/keys": "./src/testing/keys.ts",
    "./testing/tools": "./src/testing/tools.ts",
    "./composition/home-lock": "./src/composition/home-lock.ts",
    "./composition/engine-settings": "./src/composition/engine-settings.ts",
    "./composition/backup": "./src/composition/backup.ts",
    "./credentials/channels": "./src/credentials/channels.ts",
    "./credentials/telemetry": "./src/credentials/telemetry.ts",
    "./composition/telemetry": "./src/composition/telemetry.ts",
    "./ports/telemetry": "./src/ports/telemetry.ts",
    "./system-keys": "./src/system-keys/index.ts",
    "./audit": "./src/audit.ts",
    "./composition/audit-home": "./src/composition/audit-home.ts",
    "./audit-file": "./src/audit-file.ts",
    "./audit-scratch": "./src/audit-scratch.ts",
    "./testing/connectors": "./src/testing/connectors.ts",
    "./workspace-policy": "./src/workspace/shared.ts",
    "./policy": "./src/policy/index.ts",
    "./notices": "./src/notices.ts",
    "./remote/client": "./src/remote/client.ts",
    "./remote/workspace": "./src/remote/workspace.ts",
    "./composition/shared-certificate": "./src/composition/shared-certificate.ts",
    "./composition/identity-http": "./src/composition/identity-http.ts"
  },
  "scripts": {
    "test": "node ../../scripts/no-leftovers.mjs node ../../scripts/with-test-cluster.mjs node --test test/*.test.ts",
    "test:sql-v08:sql": "node ../../scripts/no-leftovers.mjs node --test --test-concurrency=1 test/sql-v08-real-sql.ts test/sql-v08-host-sql.ts",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "@types/pg": "8.23.1",
    "@types/proper-lockfile": "4.1.4",
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7",
    "proper-lockfile": "4.1.2",
    "@playwright/mcp": "0.0.85",
    "playwright": "1.64.1"
  },
  "dependencies": {
    "@backbone/core": "workspace:*",
    "pg": "8.23.0",
    "@backbone-next/harness-pi": "workspace:*",
    "jsonc-parser": "3.3.1",
    "@decimalturn/toml-patch": "3.3.0",
    "@backbone-next/connector-mail": "workspace:*",
    "@backbone-next/kernel": "workspace:*",
    "@modelcontextprotocol/client": "2.4.0",
    "@backbone-next/telemetry-otel": "workspace:*",
    "minisearch": "7.2.0",
    "standardwebhooks": "1.1.1",
    "yaml": "2.9.1",
    "openid-client": "6.8.9",
    "scimmy": "1.3.5"
  }
}
