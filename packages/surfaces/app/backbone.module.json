{
  "$schema": "../../../schemas/backbone.module.schema.json",
  "manifest": 1,
  "id": "io.github.albertoangulo/app",
  "kind": "surface",
  "version": "0.0.0",
  "licence": "Apache-2.0",
  "publisher": {
    "name": "Backbone maintainers",
    "namespace": "io.github.albertoangulo",
    "verification": {
      "method": "github",
      "status": "pending"
    }
  },
  "provides": [
    {
      "port": "Thread app (Electron, and a browser over the HTTP bridge)",
      "range": "0.x"
    }
  ],
  "consumes": [
    {
      "port": "api (projection in, command out, receipt back)",
      "range": "0.x"
    }
  ],
  "stability": "experimental",
  "capabilities": {
    "planes": [
      "personal"
    ],
    "effectClasses": [
      2
    ],
    "operations": [
      "workspace.write_document"
    ],
    "network": [
      "model-route"
    ],
    "secrets": "surrogate"
  },
  "data": {
    "owns": [
      "per-viewer UI state only: layout, theme, open tabs (through viewer.put)"
    ],
    "migrations": [],
    "export": "nothing durable of its own: work, versions and receipts belong to the platform's data home and the core"
  },
