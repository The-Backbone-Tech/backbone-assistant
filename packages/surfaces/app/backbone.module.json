  "conformance": {
    "suite": [
      "packages/surfaces/app/test/tokens.test.ts",
      "packages/surfaces/app/test/tree.test.ts",
      "packages/surfaces/app/e2e/browser.spec.ts",
      "packages/surfaces/app/e2e/electron.spec.ts",
      "packages/surfaces/app/e2e/tools.electron.spec.ts",
      "packages/surfaces/app/e2e/design.spec.ts",
      "packages/surfaces/app/test/installed-journey.test.ts",
      "packages/surfaces/app/e2e/now.electron.spec.ts",
      "packages/surfaces/app/e2e/workspace.spec.ts",
      "packages/surfaces/app/e2e/header.electron.spec.ts",
      "packages/surfaces/app/e2e/flows.spec.ts",
      "packages/surfaces/app/e2e/primitives.spec.ts",
      "packages/surfaces/app/test/export-html.test.ts",
      "packages/surfaces/app/test/export-policy.test.ts",
      "packages/surfaces/app/e2e/export.electron.spec.ts"
    ],
    "quality": {
      "level": "bronze",
      "exemptions": [
        {
          "rule": "signed build",
          "reason": "the macOS app and DMG are unsigned and not notarised; that needs an Apple Developer account"
        },
        {
          "rule": "conformance on the installed app",
          "reason": "e2e:installed runs the Electron journey on a DMG installed into a temporary folder; the neutral conformance jobs in conformance/ have not run on an installed app"
        },
        {
          "rule": "secrets: surrogate",
          "reason": "a key the person pastes in Settings passes once from the window to the platform, which seals it; the window and the engine keep only a handle"
        },
        {
          "rule": "suite in pnpm check",
          "reason": "its unit tests and journeys run per package and in CI after pnpm check; they need a browser and an Electron binary"
        }
      ]
    }
  },
  "removal": {
    "refusedWhileUnknown": true,
    "rule": "quit it and delete it; its data home stays until the person deletes it, and held UNKNOWNs stay with the core's gateway"
  },
  "swap": "any surface over the same api: another shell (Tauri, a browser tab over the HTTP bridge) or the MCP door for agents",
