{
  "$schema": "../../../schemas/backbone.module.schema.json",
  "manifest": 1,
  "id": "io.github.albertoangulo/cli",
  "kind": "surface",
  "version": "0.0.0",
  "licence": "Apache-2.0",
  "publisher": {
    "name": "Backbone maintainers",
    "namespace": "io.github.albertoangulo",
    "verification": {
      "method": "github",
      "status": "pending"
    }
  },
  "provides": [
    {
      "port": "Command line (the backbone bin)",
      "range": "0.x"
    }
  ],
  "consumes": [
    {
      "port": "api (projection in, command out, receipt back)",
      "range": "0.x"
    },
    {
      "port": "Direct messaging channels over the shared Host",
      "range": "0.x"
    }
  ],
  "stability": "experimental",
  "capabilities": {
    "planes": [
      "personal"
    ],
    "effectClasses": [
      2,
      3
    ],
    "operations": [
      "workspace.write_document",
      "channels.reply"
    ],
    "network": [
      "model-route",
      "slack-api",
      "telegram-api",
      "discord-api",
      "teams-api"
    ],
    "secrets": "surrogate"
  },
  "data": {
    "owns": [
      "<home>/cli: this command line's lock and the record of who holds it, gone when it ends"
    ],
    "migrations": [],
    "export": "nothing durable of its own: work, versions and receipts belong to the platform's data home and the core"
  },
  "dependsOn": [
    {
      "name": "@backbone-next/platform",
      "version": "workspace"
    },
    {
      "name": "@backbone-next/channels",
      "version": "workspace"
    },
    {
      "name": "ajv",
      "version": "8.20.0"
    }
  ],
  "conformance": {
    "suite": [
      "packages/surfaces/cli/test/commands.test.ts",
      "packages/surfaces/cli/test/cli.test.ts",
      "packages/surfaces/cli/test/app-line.test.ts",
      "packages/surfaces/cli/test/channels.test.ts",
      "packages/surfaces/cli/test/daemon-channel-failure.test.ts",
      "packages/surfaces/cli/test/channel-breadth.test.ts"
    ],
    "quality": {
      "level": "bronze",
      "exemptions": [
        {
          "rule": "suite in pnpm check",
          "reason": "its tests run per package and in CI after pnpm check; pnpm check runs its guide, on a real home"
        }
      ]
    }
  },
  "removal": {
    "refusedWhileUnknown": true,
    "rule": "delete the package; it holds nothing durable, and held UNKNOWNs stay with the core's gateway"
  },
  "swap": "any surface over the same api: the thread app, or the MCP door for agents",
  "digest": "sha256:66ca88f3781678c76f50266767b983a302421c281d6b87059ccaaa50fa52d060"
}
