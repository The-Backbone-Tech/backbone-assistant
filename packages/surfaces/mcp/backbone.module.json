{
  "$schema": "../../../schemas/backbone.module.schema.json",
  "manifest": 1,
  "id": "io.github.albertoangulo/mcp",
  "kind": "surface",
  "version": "0.0.0",
  "licence": "Apache-2.0",
  "publisher": {
    "name": "Backbone maintainers",
    "namespace": "io.github.albertoangulo",
    "verification": {
      "method": "github",
      "status": "pending"
    }
  },
  "provides": [
    {
      "port": "MCP door (spec 2026-07-28, stdio)",
      "range": "0.x"
    }
  ],
  "consumes": [
    {
      "port": "Gateway",
      "range": "0.x"
    }
  ],
  "stability": "experimental",
  "capabilities": {
    "planes": [
      "personal"
    ],
    "effectClasses": [
      3
    ],
    "operations": [
      "outbox.write"
    ],
    "network": [],
    "secrets": "none"
  },
  "data": {
    "owns": [],
    "migrations": [],
    "export": "nothing durable: grants, effects and receipts belong to the core and the data home"
  },
  "dependsOn": [
    {
      "name": "@backbone-next/platform",
      "version": "workspace"
    },
    {
      "name": "@modelcontextprotocol/server",
      "version": "2.4.0",
      "licence": "Apache-2.0"
    },
    {
      "name": "zod",
      "version": "4.6.7",
      "licence": "MIT"
    }
  ],
  "conformance": {
    "suite": [
      "packages/surfaces/mcp/test/door.test.ts",
      "packages/platform/test/gateway.test.ts",
      "packages/surfaces/mcp/test/key-admission.test.ts"
    ],
    "quality": {
      "level": "bronze",
      "exemptions": [
        {
          "rule": "remote transport",
          "reason": "stdio only; HTTP with authorisation is not built (see README)"
        },
        {
          "rule": "real clients",
          "reason": "automated conformance uses the official MCP client, not live external AI clients; a separate Codex CLI trial is recorded for 26 October 2026 in README.md, while Claude Code, Hermes and OpenClaw remain untried live"
        }
      ]
    }
  },
  "removal": {
    "refusedWhileUnknown": true,
    "rule": "revoke its grants first; held UNKNOWNs stay with the core's gateway and their resolvers"
  },
  "swap": "any door over the same gateway port (OpenAPI, ACP); a client can also be pointed at another MCP server",
  "digest": "sha256:37999a993b8b01eb06239bd411341479f0c3a35976ab942c2fec4598d599d5f7"
}
