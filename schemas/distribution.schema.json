{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "backbone-distribution/1",
  "title": "A distribution: chosen modules, defaults and a brand profile. Configuration only, never code.",
  "type": "object",
  "required": ["name", "brand", "modules", "defaults"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "brand": { "$ref": "#/$defs/brand" },
    "modules": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }, "uniqueItems": true },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "harness": { "type": "string" },
        "learning": { "enum": ["off", "on"] }
      }
    }
  },
  "$defs": {
    "brand": {
      "description": "The brand profile: the only place a distribution's name and look are set. Anything else is not customisable.",
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[^<>{}`$\\\\]+$" },
        "appId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*){2,}$" },
        "light": { "enum": ["warm", "neutral"] },
        "dark": { "enum": ["warm", "neutral"] },
        "icon": { "description": "A square PNG of at least 512 px, beside the distribution file: the app's icon. Without it the default icon is used.", "type": "string", "pattern": "^[^/\\\\<>{}`$]+\\.png$" }
      }
    }
  }
}
