{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "backbone-radar/1",
  "title": "A radar entry: the leader and challenger for one capability, with dated evidence and an exit route",
  "type": "object",
  "required": ["schema", "capability", "family", "decision", "leader", "challenger", "ring", "evidenceStrength", "why", "evidenceDate", "sources", "exit", "licence", "nextReview", "revalidateBy"],
  "properties": {
    "schema": { "const": "backbone-radar/1" },
    "capability": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "family": { "type": "string", "minLength": 1 },
    "acceptanceRow": { "type": "string" },
    "decision": { "type": "object", "required": ["status"], "properties": { "status": { "type": "string", "minLength": 1 } } },
    "leader": { "type": ["object", "null"] },
    "challenger": { "type": ["object", "null"] },
    "ring": { "$ref": "#/$defs/ring" },
    "evidenceStrength": { "enum": ["strong", "moderate", "weak"] },
    "why": { "$ref": "#/$defs/why" },
    "evidenceDate": { "$ref": "#/$defs/date" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "url", "date", "what"],
        "properties": { "id": { "type": "string", "minLength": 1 }, "url": { "type": "string", "minLength": 1 }, "date": { "type": "string" }, "what": { "type": "string" } }
      }
    },
    "exit": { "type": "string", "minLength": 1 },
    "revalidateBy": { "$ref": "#/$defs/date" },
    "components": { "type": "array", "items": { "type": "object", "properties": { "ring": { "$ref": "#/$defs/ring" }, "why": { "$ref": "#/$defs/why" } } } }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "ring": { "enum": ["adopt", "trial", "assess", "hold", "caution"] },
    "why": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "sources", "checked"],
        "properties": {
          "label": { "enum": ["source", "docs", "inference"] },
          "sources": { "type": "array", "items": { "type": "string" } },
          "checked": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
