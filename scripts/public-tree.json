  "forbiddenPatterns": [
    {
      "id": "personal-email",
      "source": "\\b[A-Z0-9._%+-]+@gmail\\.com\\b"
    },
    {
      "id": "owner-surname",
      "source": "\\b[a]ngulo\\b|[A-Z0-9._%+-]*[a]ngulo[A-Z0-9._%+-]*@[A-Z0-9.-]+\\.[A-Z]{2,}"
    },
    {
      "id": "home-path",
      "source": "(?<![A-Z0-9_/.-])(?:/Users/|/home/|[A-Z]:\\\\Users\\\\)[A-Z0-9._-]+",
      "syntheticAllowed": true
    },
    {
      "id": "private-evidence",
      "source": "\\b(?:backbone-owner|owner-private):",
      "syntheticAllowed": true
    },
    {
      "id": "client-session",
      "source": "\\blocal_[a-z0-9_-]{12,}\\b|\\b(?:session|thread|chat)\\b.{0,100}\\b[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}\\b|\\b[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}\\b.{0,100}\\b(?:session|thread|chat)\\b"
    },
    {
      "id": "token",
      "source": "\\b(?:sk-(?:proj-|ant-)?[A-Za-z0-9_-]{20,}|gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,}|xox[baprs]-[A-Za-z0-9-]{20,}|AIza[A-Za-z0-9_-]{30,}|AKIA[A-Z0-9]{16})\\b|-----BEGIN (?:[A-Z]+ )?PRIVATE KEY-----|\\bBearer\\s+[A-Za-z0-9._~+/-]{20,}={0,2}",
      "syntheticAllowed": true
    }
  ]
